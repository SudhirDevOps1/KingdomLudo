# ==============================================================================
# KingdomLudo — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit real secrets to source control.

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"
VITE_APP_NAME="KingdomLudo"
VITE_APP_PACKAGE_ID="com.kingdomludo.app"

# Remote WebSocket URL for client (Leave empty when hosting client & server together)
VITE_WS_URL=""

# ------------------------------------------------------------------------------
# 2. Database Provider Selection
# ------------------------------------------------------------------------------
# Supported: sqlite | supabase | postgres | neon | turso | d1
DATABASE_PROVIDER=sqlite
SQLITE_DB_PATH="./data/kingdom-ludo.sqlite"

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Configuration (Auth & PostgreSQL)
# ------------------------------------------------------------------------------
# Frontend Client Keys (Vite)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Backend Server Connection (Optional - defaults to SQLite when unset)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
POSTGRES_URL=""
POSTGRES_SSL=true

# Alternative Postgres Providers (Neon / AWS RDS)
NEON_DATABASE_URL=""

# ------------------------------------------------------------------------------
# 4. Cloudflare D1 & Workers Configuration (Optional)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# ------------------------------------------------------------------------------
# 5. Turso Edge Database (Optional)
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ------------------------------------------------------------------------------
# 6. Security, Session & Rate Limiting
# ------------------------------------------------------------------------------
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production"
WS_RATE_LIMIT_PER_MIN=120
