# ==============================================================================
# KingdomLudo — Environment Configuration Example
# ==============================================================================
# Copy to .env for local development. Never commit real secrets.

# Application Runtime
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"
VITE_APP_NAME="KingdomLudo"
VITE_APP_PACKAGE_ID="com.kingdomludo.app"
VITE_WS_URL=""

# Database Provider Selection:
# Supported: sqlite | postgres | supabase | neon | turso | d1 | firebase
DATABASE_PROVIDER=sqlite
SQLITE_DB_PATH="./data/kingdom-ludo.sqlite"

# PostgreSQL / Supabase / Neon
POSTGRES_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
NEON_DATABASE_URL=""

# Turso / libSQL
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Cloudflare D1
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# Firebase (Client Config uses firebase-applet-config.json when provisioned)
FIREBASE_PROJECT_ID=""
FIREBASE_API_KEY=""

# Security & Rate Limiting
SESSION_SECRET=""
WS_RATE_LIMIT_PER_MIN=120
