  "version": "0.1.0-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "tsx scripts/sync-version.ts sync && vite build",
    "version:sync": "tsx scripts/sync-version.ts sync",
    "version:verify": "tsx scripts/sync-version.ts verify",
    "version:bump": "tsx scripts/sync-version.ts bump",
    "version:set": "tsx scripts/sync-version.ts set",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix"
    ]
  },
